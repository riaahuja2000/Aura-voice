{
  "expo": {
    "name": "Aura Voice",
    "slug": "aura-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aura-voice",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mystiquevoicepro.fqjz1d",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload your Aura Voice logo and background images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F5FB"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.mystiquevoicepro.fqjz1d",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#F9F5FB"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Aura Voice to hear your spoken question."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload your Aura Voice logo and background images."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Aura Voice to hear your spoken question.",
          "speechRecognitionPermission": "Turn your spoken question into text for Aura Voice."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
